# sweep.cmake -- run by build/sweep.sh with shipyard-cmake -P: syntax-checks this shard of the units in a
# compile_commands.json, writing OUT/units/<index>.log as "file <path>", "rc <status>", then the compiler's
# diagnostics. -D COMMANDS=<json> OUT=<dir> SHARD=<i> SHARDS=<n>.
# spec: BUILD.md "Build evidence" -- each unit is checked on its own, so a unit behind a failed target is
#       still measured; -fsyntax-only writes no object, and -ferror-limit=0 keeps every error.
file(READ "${COMMANDS}" json)
string(JSON n LENGTH "${json}")
if(n EQUAL 0)
  return()
endif()
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  math(EXPR mine "${i} % ${SHARDS}")
  if(NOT mine EQUAL SHARD)
    continue()
  endif()
  string(JSON dir GET "${json}" ${i} directory)
  string(JSON src GET "${json}" ${i} file)
  string(JSON cmd ERROR_VARIABLE noc GET "${json}" ${i} command)
  if(noc)
    message(FATAL_ERROR "sweep: entry ${i} has no \"command\" (only Makefile/Ninja command strings are read)")
  endif()
  separate_arguments(argv UNIX_COMMAND "${cmd}")
  set(run "")
  set(skip OFF)
  set(first ON)
  foreach(a IN LISTS argv)
    if(skip)
      set(skip OFF)
    elseif(a STREQUAL "-o")
      set(skip ON)
    elseif(NOT a STREQUAL "-c")
      list(APPEND run "${a}")
      if(first)
        list(APPEND run -fsyntax-only -ferror-limit=0)
        set(first OFF)
      endif()
    endif()
  endforeach()
  execute_process(COMMAND ${run} WORKING_DIRECTORY "${dir}" RESULT_VARIABLE rc
                  OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(LENGTH "000${i}" len)
  math(EXPR start "${len} - 4")
  string(SUBSTRING "000${i}" ${start} 4 idx)
  file(WRITE "${OUT}/units/${idx}.log" "file ${src}\nrc ${rc}\n${out}${err}")
endforeach()
