@@ -0,0 +1,28 @@
+//
+//  iTermNoMetal.h
+//  iTerm2
+//
+//  Mac OS X 10.9 has no Metal. With ITERM_NO_METAL, these are the Metal and MetalKit names the
+//  legacy renderer's code still mentions, declared without either framework. Nothing declared here is
+//  ever created: -[PTYSession metalAllowed:] answers NO (iTermMetalUnavailableReasonNoGPU) first.
+//
+
+#import <Cocoa/Cocoa.h>
+
+@protocol MTLDevice <NSObject>
+@end
+
+@protocol MTKViewDelegate <NSObject>
+@end
+
+@interface MTKView : NSView
+@property (nonatomic, assign) id<MTKViewDelegate> delegate;
+@property (nonatomic, retain) id<MTLDevice> device;
+@property (nonatomic) CGColorSpaceRef colorspace;
+@property (nonatomic, getter=isPaused) BOOL paused;
+@property (nonatomic) BOOL enableSetNeedsDisplay;
+@property (nonatomic) CGSize drawableSize;
+- (void)mtkView:(MTKView *)view drawableSizeWillChange:(CGSize)size;
+@end
+
+@protocol iTermMetalDriverDataSourcePerFrameState;
