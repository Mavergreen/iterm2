+// Mavericks iTerm2: the family updater runs outside this process, so Sparkle's will-restart
+// notification comes from its post-update helper, on the distributed center (BUILD.md "Updates").
+- (void)observeUpdateRestarts {
+    [[NSDistributedNotificationCenter defaultCenter] addObserver:self
+                                                        selector:@selector(sparkleWillRestartApp:)
+                                                            name:@"SUUpdaterWillRestartNotificationName"
+                                                          object:nil];
+}
+
 - (void)sparkleWillRestartApp:(NSNotification *)notification {
     [NSApp invalidateRestorableState];
     [[NSApp windows] makeObjectsPerformSelector:@selector(invalidateRestorableState)];
     _sparkleRestarting = YES;
+    _sparkleRestartingSince = [NSDate timeIntervalSinceReferenceDate];
+    // Mavericks iTerm2: the helper quits the app only once it knows the flag is set, since its quit
+    // request and this notification travel separately and may arrive in either order.
+    [[NSDistributedNotificationCenter defaultCenter] postNotificationName:@"MavericksiTerm2WillRestartAcknowledged"
+                                                                   object:nil
+                                                                 userInfo:nil
+                                                       deliverImmediately:YES];
+}
+
+// Mavericks iTerm2: a declined quit ends the update's restart, and tells the family updater's helper,
+// which stops waiting for this app to exit.
+- (void)updateRestartWasDeclined {
+    if (_sparkleRestarting || _sparkleRestartLatched) {
+        [[NSDistributedNotificationCenter defaultCenter] postNotificationName:@"MavericksiTerm2RestartDeclined"
+                                                                       object:nil
+                                                                     userInfo:nil
+                                                           deliverImmediately:YES];
+    }
+    _sparkleRestarting = NO;
+    _sparkleRestartLatched = NO;
+}
+
+// Mavericks iTerm2: once a quit for the update has begun, its decision holds however long the quit
+// prompt stays open, so the prompt's promise that sessions will be restored is kept.
+- (void)latchUpdateRestartIfPending {
+    if (self.sparkleRestarting) {
+        _sparkleRestartLatched = YES;
+    }
+}
+
+// Mavericks iTerm2: any process in the login session can post that notification, so it counts only
+// until a quit could have followed it: 60 s, or MavericksiTerm2UpdateRestartSeconds.
+- (BOOL)sparkleRestarting {
+    if (_sparkleRestartLatched) {
+        return YES;
+    }
+    NSTimeInterval window = [[NSUserDefaults standardUserDefaults] doubleForKey:@"MavericksiTerm2UpdateRestartSeconds"];
+    if (window <= 0) {
+        window = 60;
+    }
+    return _sparkleRestarting && [NSDate timeIntervalSinceReferenceDate] - _sparkleRestartingSince < window;
+}
+
+- (IBAction)checkForUpdates:(id)sender {
+    // Mavericks iTerm2: the family updater, not an embedded Sparkle, checks for and installs
+    // updates. --user makes its check user-initiated, so it always shows its window.
+    NSString *bundleId = @ITERM_UPDATER_BUNDLE_ID;
+    NSURL *url = [[NSWorkspace sharedWorkspace] URLForApplicationWithBundleIdentifier:bundleId];
+    NSError *error = nil;
+    if (url &&
+        [[NSWorkspace sharedWorkspace] launchApplicationAtURL:url
+                                                      options:NSWorkspaceLaunchDefault
+                                                configuration:@{ NSWorkspaceLaunchConfigurationArguments: @[ @"--user" ] }
+                                                        error:&error]) {
+        return;
+    }
+    NSAlert *alert = [[[NSAlert alloc] init] autorelease];
+    if (!url) {
+        alert.messageText = @"The updater is not installed";
+        alert.informativeText =
+            [NSString stringWithFormat:@"Mavericks iTerm2 updates itself with its own updater (%@), which "
+                                       @"is not installed. Reinstall Mavericks iTerm2 from %@ to restore it.",
+                                       bundleId, @ITERM_RELEASES_URL];
+    } else {
+        alert.messageText = @"The updater could not be opened";
+        alert.informativeText =
+            [NSString stringWithFormat:@"%@ could not be opened: %@. Reinstall Mavericks iTerm2 from %@ "
+                                       @"to repair it.",
+                                       url.path, error.localizedDescription ?: @"no reason given", @ITERM_RELEASES_URL];
+    }
+    [alert addButtonWithTitle:@"OK"];
+    [alert runModal];
 }
 
