+
+// Options this app stores in the tmux server are written hex-encoded behind a prefix (upstream's
+// prefixes, so either app reads the other's), so a value the server returns can never close the
+// quotes of the command that writes it back. A value without the prefix is an old plain one and is
+// read as it is. A malformed encoded value reads as empty (CVE-2019-9535).
+static NSString *const iTermTmuxEncodingPrefixAffinities = @"a_";
+static NSString *const iTermTmuxEncodingPrefixOrigins = @"o_";
+static NSString *const iTermTmuxEncodingPrefixHidden = @"i_";
+
+static NSString *iTermTmuxEncoded(NSString *string, NSString *prefix) {
+    NSData *data = [string dataUsingEncoding:NSUTF8StringEncoding];
+    NSMutableString *result = [NSMutableString stringWithString:prefix];
+    const unsigned char *bytes = data.bytes;
+    for (NSUInteger i = 0; i < data.length; i++) {
+        [result appendFormat:@"%02x", bytes[i]];
+    }
+    return result;
+}
+
+static NSString *iTermTmuxDecoded(NSString *string, NSString *prefix) {
+    if (![string hasPrefix:prefix]) {
+        return string;
+    }
+    NSString *hex = [string substringFromIndex:prefix.length];
+    NSCharacterSet *notHex = [[NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdefABCDEF"] invertedSet];
+    if (hex.length % 2 || [hex rangeOfCharacterFromSet:notHex].location != NSNotFound) {
+        return @"";
+    }
+    NSMutableData *data = [NSMutableData dataWithCapacity:hex.length / 2];
+    for (NSUInteger i = 0; i < hex.length; i += 2) {
+        unsigned char byte = (unsigned char)strtoul([[hex substringWithRange:NSMakeRange(i, 2)] UTF8String], NULL, 16);
+        [data appendBytes:&byte length:1];
+    }
+    return [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease] ?: @"";
+}
+
+// A window name typed by the user, as one double-quoted tmux argument.
+static NSString *iTermTmuxQuotedName(NSString *name) {
+    NSString *oneLine = [[name componentsSeparatedByCharactersInSet:[NSCharacterSet newlineCharacterSet]]
+                            componentsJoinedByString:@" "];
+    return [oneLine stringByEscapingQuotes];
+}
