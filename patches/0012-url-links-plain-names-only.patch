+// Mavericks iTerm2: a URL's user and host become arguments of ssh or telnet, so each must be a plain
+// name that cannot be read as an option (upstream 168d0eee0f, ad73877882 and its sanitizedHostname).
+// Anything else refuses the whole URL. A user may not begin with "-" either, which upstream allows.
+NSString *iTermURLUsernameArgument(NSString *username) {
+    NSMutableCharacterSet *legal = [NSMutableCharacterSet alphanumericCharacterSet];
+    [legal addCharactersInString:@"_-+."];
+    if (username.length == 0 ||
+        [username hasPrefix:@"-"] ||
+        [username rangeOfCharacterFromSet:[legal invertedSet]].location != NSNotFound) {
+        ELog(@"Refusing a URL whose user name is not a plain name: %@", username);
+        return nil;
+    }
+    return [username stringWithEscapedShellCharactersIncludingNewlines:YES];
+}
+
+NSString *iTermURLHostArgument(NSString *hostname) {
+    NSString *const kAlphanumerics = @"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    NSCharacterSet *legalFirst = [NSCharacterSet characterSetWithCharactersInString:kAlphanumerics];
+    NSCharacterSet *legal = [NSCharacterSet characterSetWithCharactersInString:[kAlphanumerics stringByAppendingString:@":-."]];
+    if (hostname.length == 0 ||
+        ![legalFirst characterIsMember:[hostname characterAtIndex:0]] ||
+        [hostname rangeOfCharacterFromSet:[legal invertedSet]].location != NSNotFound) {
+        ELog(@"Refusing a URL whose host is not a plain name: %@", hostname);
+        return nil;
+    }
+    return [hostname stringWithEscapedShellCharactersIncludingNewlines:YES];
+}
+
+// Mavericks iTerm2: a profile's custom command takes a link's parts as $$HOST$$, $$USER$$ and the rest, and is
+// split into arguments, so the user and host must be plain names as above, and every free-form part is
+// shell-escaped to stay one argument. Returns nil, refusing the link, when the user or host is not.
+NSDictionary *iTermURLSubstitutions(NSString *urlString) {
+    NSURL *url = urlString ? [NSURL URLWithString:urlString] : nil;
+    NSString *host = @"";
+    NSString *user = @"";
+    if (url.host.length) {
+        host = iTermURLHostArgument(url.host);
+        if (!host) {
+            return nil;
+        }
+    }
+    if (url.user.length) {
+        user = iTermURLUsernameArgument(url.user);
+        if (!user) {
+            return nil;
+        }
+    }
+    NSString *(^escaped)(NSString *) = ^NSString *(NSString *s) {
+        return s ? [s stringWithEscapedShellCharactersIncludingNewlines:YES] : @"";
+    };
+    return @{ @"$$URL$$": escaped(urlString),
+              @"$$HOST$$": host,
+              @"$$USER$$": user,
+              @"$$PASSWORD$$": escaped([url password]),
+              @"$$PORT$$": [url port] ? [[url port] stringValue] : @"",
+              @"$$PATH$$": escaped([url path]),
+              @"$$RES$$": escaped([url resourceSpecifier]) };
+}
