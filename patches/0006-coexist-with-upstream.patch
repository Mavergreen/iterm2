+    if (appName.length == 0) {
+        // Without a name of its own there is no directory of its own: never Application Support itself.
+        NSLog(@"No CFBundleName, so no application support directory");
+        return nil;
+    }
     NSError *error;
     NSString *result = [self findOrCreateDirectory:NSApplicationSupportDirectory
                                           inDomain:NSUserDomainMask
-                               appendPathComponent:executableName
+                               appendPathComponent:appName
                                              error:&error];
     if (!result) {
         NSLog(@"Unable to find or create application support directory:\n%@", error);
