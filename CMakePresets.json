{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "include": ["/usr/local/mavergreen/shipyard/share/cmake/MavericksShipyard/mavericks-presets.json"],
  "configurePresets": [
    { "name": "inputs", "hidden": true,
      "cacheVariables": {
        "ITERM_INPUTS_FILE": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-inputs/inputs.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      } },
    { "name": "x86_64", "inherits": ["mavericks-x86_64", "inputs"],
      "displayName": "x86_64 -- iTerm2 for 10.9 on any host, with the verified installed clang22 (clang22-cross on a modern Mac)" }
  ],
  "buildPresets": [
    { "name": "x86_64", "configurePreset": "x86_64" }
  ]
}
